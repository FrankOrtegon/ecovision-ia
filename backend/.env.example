# Copiar a .env y completar. Nunca versionar .env.
ENVIRONMENT=development

# Roboflow (solo backend)
ROBOFLOW_API_KEY=gJ5zIGu374eROTFfas16
ROBOFLOW_API_URL=https://serverless.roboflow.com
# Formato "proyecto/versión" (verificado: ecovision-trashnet/1)
ROBOFLOW_MODEL_ID=ecovision-trashnet/1
ROBOFLOW_TIMEOUT_S=30

# CORS: lista separada por comas
ALLOWED_ORIGINS=http://localhost:5173

# Límites
MAX_IMAGE_MB=5
MAX_BATCH_FILES=20
MAX_EVAL_FILES=500

# Umbral informativo de confianza baja (0-1)
LOW_CONFIDENCE_THRESHOLD=0.60
